TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id
CLIENT_SECRET=your-discord-client-secret
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_ENABLED=false
WEB_SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
# Production website origin(s) allowed for same-origin auth checks (comma/space separated), e.g. https://www.tactiopbot.qd.je
WEB_ALLOWED_ORIGINS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tactiopbot@gmail.com
SMTP_PASS=
EMAIL_FROM=TACTIOPBOT <tactiopbot@gmail.com>
EMAIL_TEST_ADMIN_EMAILS=tactiopbot@gmail.com

# Website-only local development uses the shared MONGODB_URI and TACTIOPBOT database.
TACTIOBOT_DEV_PORT=3000
TACTIOBOT_DEV_GOOGLE_OAUTH_ENABLED=false
# Optional OAuth overrides; otherwise the local launcher uses GOOGLE_CLIENT_ID
# and GOOGLE_CLIENT_SECRET above with this development callback.
TACTIOBOT_DEV_GOOGLE_CLIENT_ID=
TACTIOBOT_DEV_GOOGLE_CLIENT_SECRET=
TACTIOBOT_DEV_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Shared
PORT=3000
MONGODB_URI=your-mongodb-atlas-connection-string
# WhatsApp Cloud API (Meta official)
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v22.0

TACTICOOL_API=https://club.tacticool.game



SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tactiopbot@gmail.com
SMTP_PASS=